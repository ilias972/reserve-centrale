# Modèle local : remplacez chaque valeur avant de démarrer.
# Ne commitez jamais un fichier .env réel.
DJANGO_SECRET_KEY=replace-with-a-long-random-development-only-value
DJANGO_DEBUG=0
OPERATION_GENERATION=local-instance-generation-1
LOCAL_RECOVERY_ENABLED=0
DATABASE_NAME=demo_stock_app_local
DATABASE_USER=stock_app_owner
DATABASE_PASSWORD=replace-with-a-local-only-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
TEST_DATABASE_NAME=test_stock_app_local
TEST_DATABASE_USER=stock_app_test
TEST_DATABASE_PASSWORD=replace-with-a-local-test-only-password
RUNTIME_DATABASE_USER=stock_app_runtime
RUNTIME_DATABASE_PASSWORD=replace-with-a-local-runtime-password
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
NOTIFICATION_EXTERNAL_ALLOWED=0
NOTIFICATION_PUSH_ENABLED=0
NOTIFICATION_EMAIL_MODE=CAPTURE
