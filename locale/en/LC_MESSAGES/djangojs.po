msgstr "Review decisions blocking this correction"

#: static/receiving/editor.js:9
msgid ""
"Un reliquat reste annulé : séparez les unités valablement attendues et "
"signalez les autres."
msgstr "A remainder is still cancelled: separate the units that are legitimately expected and report the others."

#: static/receiving/editor.js:9
msgid ""
"%(regular)s entreront en réserve · %(surplus)s en surplus isolé · %"
"(nonconforming)s non conformes isolés."
msgstr "%(regular)s will enter stock · %(surplus)s isolated as surplus · %(nonconforming)s isolated as non-conforming."

#: static/receiving/editor.js:10
msgid "Opération enregistrée et historisée. Consultez les données actualisées."
msgstr "Operation saved and recorded. Review the updated information."

#: static/receiving/editor.js:10
msgid "Consulter le résultat"
msgstr "View result"

#: static/receiving/editor.js:10
msgid "Opération refusée. Votre saisie est conservée."
msgstr "Operation declined. Your entries are preserved."

#: static/receiving/editor.js:28
msgid "Lecture indisponible."
msgstr "Could not retrieve the data."

#: static/receiving/editor.js:31
msgid "Aperçu refusé."
msgstr "Preview declined."

#: static/receiving/editor.js:31
msgid "En attente"
msgstr "Waiting"

#: static/receiving/editor.js:31
msgid "Partiellement reçue"
msgstr "Partially received"

#: static/receiving/editor.js:31
msgid "Reçue"
msgstr "Received"

#: static/receiving/editor.js:31
msgid "Clôturée, reliquat annulé"
msgstr "Closed, remaining quantity cancelled"

#: static/receiving/editor.js:31
msgid "Annulée sans réception"
msgstr "Cancelled without receipt"

#: static/receiving/editor.js:31
msgid "État commande : %(before)s → %(after)s"
msgstr "Order status: %(before)s → %(after)s"

#: static/receiving/editor.js:31
msgid ""
"%(name)s · %(unit)s : quantité régulière %(regular_before)s → %"
"(regular_after)s, en réserve %(physical_before)s → %(physical_after)s, "
"réservés %(reserved_before)s → %(reserved_after)s, disponibles %"
"(available_before)s → %(available_after)s, reçus %(received_before)s → %"
"(received_after)s, attendus %(waiting_before)s → %(waiting_after)s."
msgstr "%(name)s · %(unit)s: regular quantity %(regular_before)s → %(regular_after)s, in stock %(physical_before)s → %(physical_after)s, reserved %(reserved_before)s → %(reserved_after)s, available %(available_before)s → %(available_after)s, received %(received_before)s → %(received_after)s, expected %(waiting_before)s → %(waiting_after)s."

#: static/receiving/editor.js:31
msgid ""
"Isolation %(kind)s : %(before)s → %(after)s restants ; %(accepted)s déjà "
"acceptés."
msgstr "Isolated %(kind)s: %(before)s → %(after)s remaining; %(accepted)s already accepted."

#: static/receiving/editor.js:31
msgid "surplus"
msgstr "surplus"

#: static/receiving/editor.js:31
msgid "non-conformes"
msgstr "non-conforming goods"

#: static/receiving/editor.js:31
msgid "Aperçu indisponible. Aucun mouvement effectué."
msgstr "Preview unavailable. No movement was made."

#: static/receiving/editor.js:33
msgid "Nouvelle arrivée, sans dossier d’isolation antérieur"
msgstr "New delivery, with no earlier quarantine case"

#: static/receiving/editor.js:33
