msgstr "Save declined. Your entries are preserved."

#: static/purchasing/editor.js:31
msgid "Référence fournisseur : %(reference)s"
msgstr "Supplier reference: %(reference)s"

#: static/purchasing/editor.js:39
msgid "Ce produit est déjà présent. Modifiez sa quantité dans la déclaration."
msgstr "This product is already listed. Change its quantity in the entry."

#: static/purchasing/editor.js:40
msgid "Une déclaration contient au maximum 100 produits."
msgstr "An entry can contain up to 100 products."

#: static/purchasing/editor.js:45
msgid "Stock non inventorié : saisissez la quantité réellement achetée."
msgstr "Stock not inventoried: enter the quantity actually purchased."

#: static/purchasing/editor.js:45
