msgstr "View the stock conflict"

#: static/cases/editor.js:47
msgid ""
"Remise initiale : %(initial)s ; quantité effective actuelle : %(before)s ; "
"quantité réelle vérifiée : %(after)s."
msgstr "Initial issue: %(initial)s; current effective quantity: %(before)s; verified actual quantity: %(after)s."

#: static/cases/editor.js:48
msgid ""
"%(name)s (%(unit)s) — en réserve : %(p_before)s → %(p_after)s ; réservé : %"
"(r_before)s → %(r_after)s ; disponible : %(d_before)s → %(d_after)s. "
"Demandé : %(requested)s ; remis : %(issued_before)s → %(issued_after)s ; "
"clôturé : %(closed_before)s → %(closed_after)s ; reste réservé : %"
"(open_before)s → %(open_after)s."
msgstr "%(name)s (%(unit)s) — in stock: %(p_before)s → %(p_after)s; reserved: %(r_before)s → %(r_after)s; available: %(d_before)s → %(d_after)s. Requested: %(requested)s; issued: %(issued_before)s → %(issued_after)s; closed: %(closed_before)s → %(closed_after)s; still reserved: %(open_before)s → %(open_after)s."

#: static/cases/editor.js:49
msgid "Nouvelle"
msgstr "New"

#: static/cases/editor.js:49
msgid "En préparation"
msgstr "Preparing"

#: static/cases/editor.js:49
msgid "Partiellement livrée — reste à livrer"
msgstr "Partially issued — remaining quantity to issue"

#: static/cases/editor.js:49
msgid "Clôturée — quantités non remises"
msgstr "Closed — quantities not issued"

#: static/cases/editor.js:49
msgid "Livrée"
msgstr "Issued"

#: static/cases/editor.js:50
msgid "État après confirmation : %(status)s"
msgstr "Status after confirmation: %(status)s"

#: static/cases/editor.js:51
msgid "La demande restera close."
msgstr "The request will remain closed."

#: static/cases/editor.js:51
msgid "Réouverture explicitement choisie."
msgstr "Reopening was explicitly selected."

#: static/cases/editor.js:51
msgid "Le reliquat restera réservé."
msgstr "The remaining quantity will stay reserved."

#: static/cases/editor.js:53
msgid ""
"%(name)s (%(unit)s) — en réserve : %(p_before)s → %(p_after)s ; réservé : %"
"(r_before)s → %(r_after)s ; disponible : %(d_before)s → %(d_after)s."
msgstr "%(name)s (%(unit)s) — in stock: %(p_before)s → %(p_after)s; reserved: %(r_before)s → %(r_after)s; available: %(d_before)s → %(d_after)s."

#: static/cases/editor.js:54
msgid ""
"%(reference)s · %(unit)s · %(requester)s : %(released)s libérés, %"
"(reserved)s restant réservés."
msgstr "%(reference)s · %(unit)s · %(requester)s: %(released)s released, %(reserved)s still reserved."

#: static/cases/editor.js:57
msgid "Nouvel opérateur : %(name)s."
msgstr "New operator: %(name)s."

#: static/cases/editor.js:58
msgid ""
"Les personnes concernées retrouveront la décision dans le suivi de leur "
"demande. Aucune notification externe n’est envoyée."
msgstr ""
"People concerned can find this decision in the request history. No external "
"notification was sent."

#: static/cases/editor.js:69
msgid ""
"Le comptage diffère du stock enregistré. Faites d’abord vérifier et "
"régulariser cet écart dans Stocks. Aucun mouvement ni résolution enregistré."
msgstr ""
"The count differs from the recorded stock. Have the difference checked and "
"reconciled in Stock first. No movement or resolution was recorded."

#: static/cases/editor.js:71
msgid ""
"%(name)s (%(unit)s) — comptage vérifié : %(count)s ; en réserve : %"
"(p_before)s → %(p_after)s ; réservé : %(r_before)s → %(r_after)s ; "
"disponible : %(d_before)s → %(d_after)s."
msgstr "%(name)s (%(unit)s) — verified count: %(count)s; in stock: %(p_before)s → %(p_after)s; reserved: %(r_before)s → %(r_after)s; available: %(d_before)s → %(d_after)s."

#: static/cases/editor.js:72
msgid ""
"Le dossier sera résolu. La demande, ses quantités et son état restent "
"inchangés. Le serveur revérifiera les versions et l’absence de conflit à la "
"confirmation."
msgstr ""
"The case will be resolved. The request, quantities and status will stay "
"unchanged. The server will recheck versions and conflicts when you confirm."

#: static/cases/editor.js:80
msgid "Prévisualisation impossible. Aucun mouvement enregistré."
msgstr "Preview unavailable. No movement was recorded."

#: static/cases/editor.js:82
msgid ""
"Connexion indisponible. Aucune correction envoyée ; votre saisie est "
"conservée."
msgstr ""
"Connection unavailable. No correction was sent; your entries are saved."

#: static/inventory/editor.js:35
msgid "Ouvrir le signalement"
msgstr "Open the report"

#: static/inventory/editor.js:51
msgid "Corrigez les quantités signalées avant confirmation"
msgstr "Correct the flagged quantities before confirming"

#: static/inventory/editor.js:51
msgid "Aucune modification provisoire"
msgstr "No draft changes"

#: static/inventory/editor.js:53
msgid "%(name)s : %(physical)s → %(target)s %(unit)s"
msgstr "%(name)s: %(physical)s → %(target)s %(unit)s"

#: static/inventory/editor.js:53 static/inventory/editor.js:72
#: static/inventory/editor.js:91 static/inventory/editor.js:95
msgid "Non inventorié"
msgstr "Not inventoried"

#: static/inventory/editor.js:60
msgid "Saisissez un entier positif ou nul."
msgstr "Enter a positive integer or zero."

#: static/inventory/editor.js:60
msgid "Saisissez explicitement une quantité, zéro compris."
msgstr "Enter a quantity explicitly, including zero."

#: static/inventory/editor.js:62
msgid "Saisissez une quantité entière, zéro compris, avant confirmation."
msgstr "Enter a whole number, including zero, before confirming."

#: static/inventory/editor.js:72 static/inventory/editor.js:91
msgid "%(physical)s → %(target)s"
msgstr "%(physical)s → %(target)s"

#: static/inventory/editor.js:88 static/inventory/editor.js:263
#: static/requests/cart.js:47
